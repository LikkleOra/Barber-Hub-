// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// --- Domain Models aligned with PRD (BarberHub) ---

// NextAuth core models
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?

  // Local auth
  hashedPassword String?

  // Domain
  role           Role      @default(CLIENT)
  phone          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  barberProfile  BarberProfile?
  bookings       Booking[]        @relation("UserBookings")
  reviews        Review[]
  posts          CommunityMessage[] @relation("UserMessages")
  communityMemberships CommunityMembership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  BARBER
  CLIENT
}

model BarberProfile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  displayName            String
  bio                    String?
  avatarUrl              String?
  // Socials
  instagramUrl           String?
  tiktokUrl              String?
  whatsappUrl            String?

  // Public funnel
  funnelSlug             String          @unique
  funnelTitle            String?
  funnelVideoUrl         String?
  isOnboardingComplete   Boolean         @default(false)

  // Timestamps
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               Service[]
  weeklyAvailabilities   WeeklyAvailability[]
  bookings               Booking[]
  reviews                Review[]
  communityMessages      CommunityMessage[]
  galleryItems           GalleryItem[]
  memberships            CommunityMembership[]

  @@index([funnelSlug])
}

model Service {
  id               String         @id @default(cuid())
  barberProfileId  String
  name             String
  description      String?
  durationMinutes  Int
  priceCents       Int
  active           Boolean        @default(true)

  barber           BarberProfile  @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  @@index([barberProfileId])
}

// Weekly recurring availability windows (local time in minutes since midnight)
model WeeklyAvailability {
  id               String        @id @default(cuid())
  barberProfileId  String
  dayOfWeek        Int           // 0=Sunday .. 6=Saturday
  startMinutes     Int           // 0..1439
  endMinutes       Int           // 1..1440

  barber           BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([barberProfileId, dayOfWeek])
}

model Booking {
  id               String        @id @default(cuid())
  barberProfileId  String
  serviceId        String
  clientId         String
  startTime        DateTime
  endTime          DateTime
  status           BookingStatus @default(CONFIRMED)
  notes            String?
  depositCents     Int?          // Optional deposits
  paymentStatus    PaymentStatus @default(NONE)
  createdAt        DateTime      @default(now())

  barber           BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  service          Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client           User          @relation("UserBookings", fields: [clientId], references: [id], onDelete: Cascade)
  review           Review?

  @@index([barberProfileId])
  @@index([clientId])
  @@index([startTime])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  NONE
  DEPOSIT_PAID
  PAID
}

model Review {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  barberProfileId  String
  clientId         String
  rating           Int           // 1..5
  text             String?
  photoUrl         String?
  status           ReviewStatus  @default(PENDING_APPROVAL)
  createdAt        DateTime      @default(now())

  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber           BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  client           User          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([barberProfileId])
  @@index([clientId])
}

enum ReviewStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Group chat per barber
model CommunityMessage {
  id               String        @id @default(cuid())
  barberProfileId  String
  authorId         String
  content          String
  imageUrl         String?
  createdAt        DateTime      @default(now())

  barber           BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  author           User          @relation("UserMessages", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([barberProfileId, createdAt])
}

model GalleryItem {
  id               String        @id @default(cuid())
  barberProfileId  String
  imageUrl         String
  caption          String?
  visible          Boolean       @default(true)
  createdAt        DateTime      @default(now())

  barber           BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([barberProfileId, createdAt])
}

model CommunityMembership {
  id               String        @id @default(cuid())
  barberProfileId  String
  userId           String
  joinedAt         DateTime      @default(now())

  barber           BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([barberProfileId, userId])
  @@index([userId])
}
